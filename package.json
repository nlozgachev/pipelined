{
	"name": "@nlozgachev/pipelined",
	"version": "0.60.0",
	"description": "Opinionated functional abstractions for TypeScript",
	"license": "BSD-3-Clause",
	"homepage": "https://pipelined.lozgachev.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nlozgachev/pipelined.git"
	},
	"keywords": [
		"functional",
		"fp",
		"typescript",
		"composition",
		"pipe"
	],
	"types": "./dist/index.d.ts",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=18.0.0"
	},
	"files": [
		"dist"
	],
	"imports": {
		"#core": "./src/Core/index.ts",
		"#data": "./src/Data/index.ts",
		"#types": "./src/Types/index.ts",
		"#composition": "./src/Composition/index.ts",
		"#internal": "./src/internal/index.ts"
	},
	"exports": {
		"./composition": {
			"import": {
				"types": "./dist/composition.d.ts",
				"default": "./dist/composition.mjs"
			},
			"require": {
				"types": "./dist/composition.d.cts",
				"default": "./dist/composition.cjs"
			}
		},
		"./core": {
			"import": {
				"types": "./dist/core.d.ts",
				"default": "./dist/core.mjs"
			},
			"require": {
				"types": "./dist/core.d.cts",
				"default": "./dist/core.cjs"
			}
		},
		"./data": {
			"import": {
				"types": "./dist/data.d.ts",
				"default": "./dist/data.mjs"
			},
			"require": {
				"types": "./dist/data.d.cts",
				"default": "./dist/data.cjs"
			}
		},
		"./types": {
			"import": {
				"types": "./dist/types.d.ts",
				"default": "./dist/types.mjs"
			},
			"require": {
				"types": "./dist/types.d.cts",
				"default": "./dist/types.cjs"
			}
		}
	},
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"bench": "vitest bench",
		"size": "size-limit",
		"typecheck": "tsc --noEmit",
		"publish:npm": "pnpm build && npm publish --access public",
		"lint": "oxlint src/",
		"format": "dprint fmt && dprint fmt --config dprint.md.json \"docs/**/*.md\" \"docs/**/*.mdx\" \"README.md\"",
		"format:check": "dprint check && dprint check --config dprint.md.json \"docs/**/*.md\" \"docs/**/*.mdx\" \"README.md\"",
		"release:patch": "bumpp --patch -c -t -p",
		"release:minor": "bumpp --minor -c -t -p",
		"docs:dev": "pnpm --filter pipelined-docs dev",
		"docs:build": "pnpm --filter pipelined-docs build"
	},
	"devDependencies": {
		"@size-limit/file": "13.0.3",
		"@types/node": "26.2.0",
		"@vitest/coverage-v8": "4.1.10",
		"bumpp": "12.2.0",
		"dprint": "0.55.2",
		"fast-check": "4.9.0",
		"oxlint": "1.78.0",
		"size-limit": "13.0.3",
		"tsup": "8.5.1",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	},
	"size-limit": [
		{
			"path": "dist/index.mjs",
			"limit": "25 KB",
			"gzip": true
		},
		{
			"path": "dist/core.mjs",
			"limit": "16 KB",
			"gzip": true
		},
		{
			"path": "dist/composition.mjs",
			"limit": "3 KB",
			"gzip": true
		},
		{
			"path": "dist/data.mjs",
			"limit": "10 KB",
			"gzip": true
		},
		{
			"path": "dist/types.mjs",
			"limit": "700 B",
			"gzip": true
		}
	],
	"packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
