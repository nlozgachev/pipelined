{
	"name": "@nlozgachev/pipelined",
	"version": "0.50.0",
	"description": "Opinionated functional abstractions for TypeScript",
	"license": "BSD-3-Clause",
	"homepage": "https://pipelined.lozgachev.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nlozgachev/pipelined.git"
	},
	"keywords": [
		"functional",
		"fp",
		"typescript",
		"composition",
		"pipe"
	],
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"engines": {
		"node": ">=24.19.0"
	},
	"files": [
		"dist"
	],
	"imports": {
		"#core": "./src/Core/index.ts",
		"#data": "./src/Data/index.ts",
		"#types": "./src/Types/index.ts",
		"#composition": "./src/Composition/index.ts",
		"#internal": "./src/internal/index.ts"
	},
	"exports": {
		"./composition": {
			"types": "./dist/composition.d.ts",
			"import": "./dist/composition.mjs",
			"require": "./dist/composition.cjs"
		},
		"./core": {
			"types": "./dist/core.d.ts",
			"import": "./dist/core.mjs",
			"require": "./dist/core.cjs"
		},
		"./data": {
			"types": "./dist/data.d.ts",
			"import": "./dist/data.mjs",
			"require": "./dist/data.cjs"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.mjs",
			"require": "./dist/types.cjs"
		}
	},
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"bench": "vitest bench",
		"size": "size-limit",
		"typecheck": "tsc --noEmit",
		"publish:npm": "pnpm build && npm publish --access public",
		"lint": "oxlint src/",
		"format": "dprint fmt && dprint fmt --config dprint.md.json \"docs/**/*.md\" \"docs/**/*.mdx\" \"README.md\"",
		"format:check": "dprint check && dprint check --config dprint.md.json \"docs/**/*.md\" \"docs/**/*.mdx\" \"README.md\"",
		"release:patch": "bumpp --patch -c -t -p",
		"release:minor": "bumpp --minor -c -t -p",
		"docs:dev": "pnpm --filter pipelined-docs dev",
		"docs:build": "pnpm --filter pipelined-docs build"
	},
	"devDependencies": {
		"@size-limit/file": "13.0.3",
		"@types/node": "26.2.0",
		"@vitest/coverage-v8": "4.1.10",
		"bumpp": "12.2.0",
		"dprint": "0.55.2",
		"fast-check": "4.9.0",
		"oxlint": "1.78.0",
		"size-limit": "13.0.3",
		"tsup": "8.5.1",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	},
	"size-limit": [
		{
			"path": "dist/index.js",
			"limit": "25 KB",
			"gzip": true
		},
		{
			"path": "dist/core.js",
			"limit": "16 KB",
			"gzip": true
		},
		{
			"path": "dist/composition.js",
			"limit": "4 KB",
			"gzip": true
		},
		{
			"path": "dist/data.js",
			"limit": "13 KB",
			"gzip": true
		},
		{
			"path": "dist/types.js",
			"limit": "2 KB",
			"gzip": true
		}
	],
	"packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f"
}
