{
	"name": "@pplnd/core",
	"version": "0.90.0",
	"description": "Typed errors, explicit optional values, and composable pipelines for TypeScript",
	"keywords": [
		"typescript",
		"result",
		"maybe",
		"error-handling",
		"typed-errors",
		"validation",
		"pipe",
		"flow",
		"async",
		"concurrency",
		"retry",
		"remotedata",
		"lens",
		"branded-types"
	],
	"homepage": "https://pipelined.lozgachev.dev",
	"license": "BSD-3-Clause",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pplnd/core.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#core": "./src/Core/index.ts",
		"#data": "./src/Data/index.ts",
		"#types": "./src/Types/index.ts",
		"#composition": "./src/Composition/index.ts",
		"#internal": "./src/internal/index.ts",
		"#test-utils": "./test-utils.ts"
	},
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:types": "vitest run --typecheck.only",
		"test:coverage": "vitest run --coverage",
		"bench": "vitest bench",
		"size": "size-limit",
		"size:update": "node scripts/sync-bundle-sizes.ts",
		"size:check": "vitest run src/__tests__/BundleSize.test.ts",
		"typecheck": "tsc --noEmit",
		"typecheck:dev": "tsc --noEmit --watch",
		"typecheck:min": "pnpm dlx --package typescript@5.5 tsc --noEmit --skipLibCheck",
		"publish:npm": "pnpm build && npm publish --access public",
		"lint": "oxlint src/",
		"format": "dprint fmt && dprint fmt --config dprint.md.json \"docs/**/*.md\" \"docs/**/*.mdx\" \"README.md\" \"CODE_OF_CONDUCT.md\" \"CONTRIBUTING.md\" \".github/**/*.md\"",
		"format:check": "dprint check && dprint check --config dprint.md.json \"docs/**/*.md\" \"docs/**/*.mdx\" \"README.md\" \"CODE_OF_CONDUCT.md\" \"CONTRIBUTING.md\" \".github/**/*.md\"",
		"format:imports": "node scripts/format-guide-imports.ts",
		"format:imports:check": "node scripts/format-guide-imports.ts --check",
		"docs:dev": "pnpm --filter pipelined-docs dev",
		"docs:build": "pnpm --filter pipelined-docs build",
		"check": "pnpm typecheck && pnpm test:types && pnpm lint && pnpm format:check"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "0.18.5",
		"@size-limit/esbuild": "14.3.0",
		"@size-limit/file": "14.3.0",
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "5.0.5",
		"dprint": "0.64.3",
		"esbuild": "0.28.2",
		"fast-check": "4.10.2",
		"oxlint": "1.89.0",
		"publint": "0.3.25",
		"size-limit": "14.3.0",
		"tsdown": "0.23.2",
		"typescript": "6.0.3",
		"vitest": "5.0.5"
	},
	"size-limit": [
		{
			"name": "Index (Monolithic import *)",
			"import": "*",
			"path": "dist/index.mjs",
			"limit": "23 KB",
			"gzip": true,
			"ignore": [
				"util",
				"node:util"
			]
		},
		{
			"name": "pipe",
			"import": "{ pipe }",
			"path": "dist/index.mjs",
			"limit": "200 B",
			"gzip": true
		},
		{
			"name": "flow",
