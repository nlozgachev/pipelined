{
	"name": "@nlozgachev/pipelined",
	"version": "0.71.0",
	"description": "Opinionated functional abstractions for TypeScript",
	"keywords": [
		"composition",
		"fp",
		"functional",
		"pipe",
		"typescript"
	],
	"homepage": "https://pipelined.lozgachev.dev",
	"license": "BSD-3-Clause",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nlozgachev/pipelined.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./dist/index.d.ts",
	"imports": {
		"#core": "./src/Core/index.ts",
		"#data": "./src/Data/index.ts",
		"#types": "./src/Types/index.ts",
		"#composition": "./src/Composition/index.ts",
		"#internal": "./src/internal/index.ts"
	},
	"exports": {
		"./composition": {
			"import": {
				"types": "./dist/composition.d.ts",
				"default": "./dist/composition.mjs"
			},
			"require": {
				"types": "./dist/composition.d.cts",
				"default": "./dist/composition.cjs"
			}
		},
		"./core": {
			"import": {
				"types": "./dist/core.d.ts",
				"default": "./dist/core.mjs"
			},
			"require": {
				"types": "./dist/core.d.cts",
				"default": "./dist/core.cjs"
			}
		},
		"./data": {
			"import": {
				"types": "./dist/data.d.ts",
				"default": "./dist/data.mjs"
			},
			"require": {
				"types": "./dist/data.d.cts",
				"default": "./dist/data.cjs"
			}
		},
		"./types": {
			"import": {
				"types": "./dist/types.d.ts",
				"default": "./dist/types.mjs"
			},
			"require": {
				"types": "./dist/types.d.cts",
				"default": "./dist/types.cjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"bench": "vitest bench",
		"size": "size-limit",
		"typecheck": "tsc --noEmit",
		"typecheck:dev": "tsc --noEmit --watch",
		"typecheck:min": "pnpm dlx --package typescript@5.5 tsc --noEmit --skipLibCheck",
		"publish:npm": "pnpm build && npm publish --access public",
		"lint": "oxlint src/",
		"format": "dprint fmt && dprint fmt --config dprint.md.json \"docs/**/*.md\" \"docs/**/*.mdx\" \"README.md\"",
		"format:check": "dprint check && dprint check --config dprint.md.json \"docs/**/*.md\" \"docs/**/*.mdx\" \"README.md\"",
		"docs:dev": "pnpm --filter pipelined-docs dev",
		"docs:build": "pnpm --filter pipelined-docs build",
		"check": "pnpm typecheck && pnpm lint && pnpm format:check"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "0.18.5",
		"@size-limit/esbuild": "14.1.0",
		"@size-limit/file": "14.1.0",
		"@types/node": "26.6.4",
		"@vitest/coverage-v8": "5.0.3",
		"dprint": "0.60.1",
		"esbuild": "0.28.2",
		"fast-check": "4.10.2",
		"oxlint": "1.87.0",
		"publint": "0.3.25",
		"size-limit": "14.1.0",
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"vitest": "5.0.3"
	},
	"size-limit": [
		{
			"name": "Index (Monolithic import *)",
			"import": "*",
			"path": "dist/index.mjs",
			"limit": "18 KB",
			"gzip": true,
			"ignore": [
				"util",
				"node:util"
			]
		},
		{
			"name": "Core (import * as Core)",
			"import": "*",
			"path": "dist/core.mjs",
			"limit": "11 KB",
			"gzip": true
		},
		{
			"name": "Data (import * as Data)",
			"import": "*",
			"path": "dist/data.mjs",
			"limit": "10 KB",
			"gzip": true
		},
		{
			"name": "Composition (import * as Composition)",
			"import": "*",
			"path": "dist/composition.mjs",
			"limit": "2 KB",
			"gzip": true,
			"ignore": [
				"util",
				"node:util"
			]
		},
		{
			"name": "Types (import * as Types)",
			"import": "*",
			"path": "dist/types.mjs",
			"limit": "450 B",
			"gzip": true
		}
	],
	"engines": {
		"node": ">=18.0.0"
	}
}
