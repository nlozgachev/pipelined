---
import { Card, CardGrid } from "@astrojs/starlight/components";
import fs from "node:fs";
import path from "node:path";

function getBarrelExports(relPath: string): string[] {
	try {
		const fullPath = path.resolve(process.cwd(), relPath);
		const content = fs.readFileSync(fullPath, "utf-8");
		const matches = content.matchAll(/export\s+\*\s+from\s+["']\.\/([^"']+)["']/g);
		const names: string[] = [];
		for (const match of matches) {
			names.push(match[1]);
		}
		return names.sort();
	} catch {
		return [];
	}
}

const coreExports = getBarrelExports("../src/Core/index.ts");
const dataExports = getBarrelExports("../src/Data/index.ts");
const compositionExports = getBarrelExports("../src/Composition/index.ts");
const typesExports = getBarrelExports("../src/Types/index.ts");

const entryPoints = [
	{
		title: "/core",
		description: "Sum types for error handling, optional values, async execution, event streams, state, and optics.",
		exports: coreExports,
	},
	{
		title: "/data",
		description: "Pure curried utilities for arrays, records, dictionaries, strings, numbers, and JSON.",
		exports: dataExports,
	},
	{
		title: "/composition",
		description: "Pipeline runners, flow composition, and execution control combinators.",
		exports: compositionExports,
	},
	{
		title: "/types",
		description: "Domain primitives, compile-time branded types, duration units, and retry policies.",
		exports: typesExports,
	},
];
---

<CardGrid>
	{entryPoints.map((entry) => (
		<Card title={entry.title}>
			<p>{entry.description}</p>
			<p>
				<strong>Exports:</strong>{" "}
				{entry.exports.map((name, i) => (
					<><code>{name}</code>{i < entry.exports.length - 1 ? " " : ""}</>
				))}
			</p>
		</Card>
	))}
</CardGrid>
